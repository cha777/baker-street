# Telegram Bot Configuration (Get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Optional: Leave empty to allow any user with the bot link, or provide comma-separated Telegram User IDs
TELEGRAM_ALLOWED_USER_IDS=

# Encryption key for storing user credentials at rest (any secret string)
ENCRYPTION_KEY=baker-street-default-secret-key-change-me-2026

# BrainxHR Portal URL
BRAINXHR_URL=https://brainxhr.directfn.net/private/task/cafe-order-food

# Optional fallback credentials for running `npm run inspect` from CLI
BRAINXHR_USERNAME=
BRAINXHR_PASSWORD=

# Order Options & Initial Defaults
DEFAULT_LOCATION=ICC Techno Hub
DEFAULT_ORDER_FOR=My self
DEFAULT_FOOD_TYPE=Chicken

LOCATIONS=ICC Techno Hub,Villa
ORDER_FOR_OPTIONS=My self,For a colleague,For a visitor
FOOD_TYPES=Chicken,Egg,Fish,Vegetable

# Scheduler Timezone & Default Time
TIMEZONE=Asia/Colombo
DEFAULT_SCHEDULE_TIME=08:30

# Browser Options (true for background headless, false to watch browser window)
HEADLESS=true
